from typing import Literal

__version__: str

Layout = Literal["nudi", "baraha", "akruti", "shree-lipi", "nudi-b", "kan-eng"]
Form = Literal["canonical", "legacy", "search"]
Scheme = Literal["kannada", "iso15919", "iast", "baraha"]

class Conversion:
    @property
    def text(self) -> str: ...
    @property
    def unknown(self) -> list[tuple[int, str]]: ...
    @property
    def malformed(self) -> list[tuple[int, int]]: ...
    @property
    def is_clean(self) -> bool: ...

class Encoding:
    @property
    def text(self) -> str: ...
    @property
    def unencodable(self) -> list[tuple[int, str]]: ...
    @property
    def malformed(self) -> list[tuple[int, int]]: ...
    @property
    def is_clean(self) -> bool: ...

def to_unicode(text: str, layout: Layout | str = "nudi", *, kannada_digits: bool = False, zero_as_anusvara: bool = True) -> Conversion: ...
def from_unicode(text: str, layout: Layout | str = "nudi") -> Encoding: ...
def best_layout(text: str) -> Layout: ...
def font_layout(name: str) -> Layout | None: ...
def is_legacy_font(name: str) -> bool: ...
def normalize(text: str, form: Form | str = "canonical") -> str: ...
def aksharas(text: str) -> list[str]: ...
def count_aksharas(text: str) -> int: ...
def transliterate(text: str, source: Scheme | str, target: Scheme | str) -> str: ...
def modernize(text: str) -> str: ...
